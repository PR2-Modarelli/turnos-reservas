# Copiar a .env y completar localmente. No publicar secretos.
TURNOS_PORT=8082
TURNOS_ZONA=America/Argentina/Mendoza
CATALOGO_URL=http://localhost:8081
# Misma clave Base64 de al menos 64 bytes que CATALOGO_JWT_SECRET.
TURNOS_JWT_SECRET=
CATEDRA_BASE_URL=
CATEDRA_TOKEN=

# PostgreSQL exclusivo de turnos. Elegir una clave local.
TURNOS_DB_URL=jdbc:postgresql://localhost:5434/turnos
TURNOS_DB_USER=turnos
TURNOS_DB_PASSWORD=
